<config>
    <executableName>${app.executable}</executableName>
    <mainClass>${app.mainclass}</mainClass>
    <os>ios</os>
    <arch>arm64</arch>
    <target>ios</target>
    <iosInfoPList>Info.plist.xml</iosInfoPList>
    <resources>
        <resource>
            <directory>data</directory>
        </resource>
    </resources>
    <forceLinkClasses>
        <pattern>*</pattern>
        <pattern>MobileKeyboard</pattern>
        <pattern>voidawt.**</pattern>
        <pattern>voidapplet.**</pattern>
        <pattern>voidswing.**</pattern>
        <pattern>voidsound.**</pattern>
        <pattern>voidmgmt.**</pattern>
        <pattern>voidsun.**</pattern>
        <pattern>jagdx.**</pattern>
        <pattern>jaggl.**</pattern>
        <pattern>jagtheora.**</pattern>
        <pattern>jagex3.**</pattern>
        <pattern>jaclib.**</pattern>
        <pattern>com.ms.**</pattern>
        <pattern>world.gregs.voidosrs.ios.**</pattern>
        <pattern>com.android.okhttp.HttpHandler</pattern>
        <pattern>com.android.okhttp.HttpsHandler</pattern>
        <pattern>com.android.org.conscrypt.**</pattern>
        <pattern>com.android.org.bouncycastle.jce.provider.BouncyCastleProvider</pattern>
        <pattern>org.apache.harmony.security.provider.cert.DRLCertFactory</pattern>
        <pattern>org.apache.harmony.security.provider.crypto.CryptoProvider</pattern>
    </forceLinkClasses>
    <frameworks>
        <framework>UIKit</framework>
        <framework>Foundation</framework>
        <framework>CoreGraphics</framework>
        <framework>CoreText</framework>
        <framework>QuartzCore</framework>
        <framework>Security</framework>
        <framework>CFNetwork</framework>
        <framework>AVFoundation</framework>
        <framework>AudioToolbox</framework>
        <framework>CoreAudio</framework>
        <!-- DualShock / Xbox / MFi → virtual mouse (mirrors Android gamepad path). -->
        <framework>GameController</framework>
    </frameworks>
</config>
